	partition Orders = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents(SourceFile), null, true),
				    Sheet = Source{[Item = "in", Kind = "Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars = true]),
				    // The workbook's date columns are inconsistent: cells Excel auto-converted
				    // have day and month swapped, the rest are M/D/YYYY text. Repair both.
				    FixDate = (v as any) as nullable date =>
				        if v = null then null
				        else if Value.Is(v, type datetime) or Value.Is(v, type date) then
				            #date(Date.Year(v), Date.Day(v), Date.Month(v))
				        else
				            let p = Text.Split(Text.Trim(Text.From(v)), "/")
				            in #date(Number.From(p{2}), Number.From(p{0}), Number.From(p{1})),
				    Dates = Table.TransformColumns(Promoted, {{"Order Date", FixDate, type date}, {"Ship Date", FixDate, type date}}),
				    PostalText = Table.TransformColumns(Dates, {{"Postal Code", each if _ = null then null else Text.PadStart(Text.From(_), 5, "0"), type text}}),
				    Typed = Table.TransformColumnTypes(PostalText, {{"Row ID", Int64.Type}, {"Order ID", type text}, {"Ship Mode", type text}, {"Customer ID", type text}, {"Customer Name", type text}, {"Segment", type text}, {"Country", type text}, {"City", type text}, {"State", type text}, {"Postal Code", type text}, {"Region", type text}, {"Product ID", type text}, {"Category", type text}, {"Sub-Category", type text}, {"Product Name", type text}, {"Sales", type number}, {"Quantity", Int64.Type}, {"Discount", type number}, {"Profit", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

