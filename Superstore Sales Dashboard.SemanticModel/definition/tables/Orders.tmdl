table Orders
	lineageTag: 4f653720-40ed-4774-b287-f9a88e69ef10

	/// Sum of sales value across all order lines.
	measure 'Total Sales' = SUM ( Orders[Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Key Measures
		lineageTag: cda126d3-5410-458c-a31c-e5f7822b2a4b

	/// Sum of profit across all order lines.
	measure 'Total Profit' = SUM ( Orders[Profit] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Key Measures
		lineageTag: 22af9eed-2b04-4f92-a671-f629925041da

	/// Number of distinct orders.
	measure 'Total Orders' = DISTINCTCOUNT ( Orders[Order ID] )
		formatString: #,0
		displayFolder: Key Measures
		lineageTag: 527e7822-fa43-4495-b5fd-582ab9162f50

	/// Total Profit as a share of Total Sales.
	measure 'Profit Margin' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.00%
		displayFolder: Key Measures
		lineageTag: 20372ac6-4557-4ae2-9113-fb5b5bf08c0a

	/// Units sold.
	measure 'Total Quantity' = SUM ( Orders[Quantity] )
		formatString: #,0
		displayFolder: Key Measures
		lineageTag: 6f69bdc9-d57f-4923-b150-dac74c8ed05b

	/// Average discount rate across order lines.
	measure 'Avg Discount' = AVERAGE ( Orders[Discount] )
		formatString: 0.0%
		displayFolder: Key Measures
		lineageTag: 468a18f3-95e3-4ce2-8cdf-c1ca352aeab7

